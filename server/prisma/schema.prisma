generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  simulations      SimulationScenario[]
  id               String                @id @default(uuid())
  name             String
  email            String                @unique
  passwordHash     String
  role             String                @default("Inventory Manager")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deliveries       DeliveryOrder[]
  transfers        InternalTransfer[]
  adjustments      InventoryAdjustment[]
  InventoryAnomaly InventoryAnomaly[]
  receipts         Receipt[]
  ledgerEvents     StockLedgerEntry[]
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model UnitOfMeasure {
  id        String    @id @default(uuid())
  name      String    @unique
  symbol    String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Warehouse {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  address   String?
  createdAt DateTime   @default(now())
  locations Location[]
}

model Location {
  simEventsFrom    SimulationEvent[]     @relation("SimSource")
  simEventsTo      SimulationEvent[]     @relation("SimDest")
  id               String                @id @default(uuid())
  warehouseId      String
  name             String
  code             String
  type             String                @default("Rack")
  createdAt        DateTime              @default(now())
  deliveries       DeliveryOrder[]
  transfersTo      InternalTransfer[]    @relation("TransferDestination")
  transfersFrom    InternalTransfer[]    @relation("TransferSource")
  adjustments      InventoryAdjustment[]
  InventoryAnomaly InventoryAnomaly[]
  balances         InventoryBalance[]
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  receipts         Receipt[]
  reorderingRules  ReorderingRule[]
  ledgerEventsFrom StockLedgerEntry[]    @relation("LedgerFrom")
  ledgerEventsTo   StockLedgerEntry[]    @relation("LedgerTo")

  @@unique([warehouseId, code])
}

model Product {
  simEvents        SimulationEvent[]
  id               String                @id @default(uuid())
  name             String
  sku              String                @unique
  categoryId       String
  unitOfMeasureId  String
  initialStock     Float?                @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  isBatchTracked   Boolean               @default(false)
  isExpiryTracked  Boolean               @default(false)
  deliveryItems    DeliveryItem[]
  adjustments      InventoryAdjustment[]
  InventoryAnomaly InventoryAnomaly[]
  balances         InventoryBalance[]
  category         Category              @relation(fields: [categoryId], references: [id])
  unitOfMeasure    UnitOfMeasure         @relation(fields: [unitOfMeasureId], references: [id])
  ProductBatch     ProductBatch[]
  receiptItems     ReceiptItem[]
  reorderingRules  ReorderingRule[]
  ledgerEntries    StockLedgerEntry[]
  transferItems    TransferItem[]
}

model InventoryBalance {
  id           String        @id @default(uuid())
  productId    String
  locationId   String
  quantity     Float         @default(0)
  updatedAt    DateTime      @updatedAt
  batchId      String?
  ProductBatch ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ReorderingRule {
  id             String    @id @default(uuid())
  productId      String
  locationId     String?
  minQuantity    Float     @default(10)
  maxQuantity    Float?
  targetQuantity Float?    @default(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Receipt {
  id                    String        @id @default(uuid())
  receiptNumber         String        @unique
  supplierName          String
  destinationLocationId String
  status                String        @default("Draft")
  notes                 String?
  validatedAt           DateTime?
  createdByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdByUser         User?         @relation(fields: [createdByUserId], references: [id])
  destinationLocation   Location      @relation(fields: [destinationLocationId], references: [id])
  items                 ReceiptItem[]
}

model ReceiptItem {
  id           String        @id @default(uuid())
  receiptId    String
  productId    String
  quantity     Float
  notes        String?
  batchId      String?
  ProductBatch ProductBatch? @relation(fields: [batchId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  receipt      Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model DeliveryOrder {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  customerName     String
  sourceLocationId String
  status           String         @default("Draft")
  pickStatus       String         @default("Pending")
  packStatus       String         @default("Pending")
  notes            String?
  validatedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            DeliveryItem[]
  createdByUser    User?          @relation(fields: [createdByUserId], references: [id])
  sourceLocation   Location       @relation(fields: [sourceLocationId], references: [id])
}

model DeliveryItem {
  id             String        @id @default(uuid())
  deliveryId     String
  productId      String
  quantity       Float
  pickedQuantity Float         @default(0)
  packedQuantity Float         @default(0)
  batchId        String?
  ProductBatch   ProductBatch? @relation(fields: [batchId], references: [id])
  delivery       DeliveryOrder @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id])
}

model InternalTransfer {
  id                    String         @id @default(uuid())
  transferNumber        String         @unique
  sourceLocationId      String
  destinationLocationId String
  status                String         @default("Draft")
  notes                 String?
  validatedAt           DateTime?
  createdByUserId       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdByUser         User?          @relation(fields: [createdByUserId], references: [id])
  destinationLocation   Location       @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  sourceLocation        Location       @relation("TransferSource", fields: [sourceLocationId], references: [id])
  items                 TransferItem[]
}

model TransferItem {
  id           String           @id @default(uuid())
  transferId   String
  productId    String
  quantity     Float
  batchId      String?
  ProductBatch ProductBatch?    @relation(fields: [batchId], references: [id])
  product      Product          @relation(fields: [productId], references: [id])
  transfer     InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model InventoryAdjustment {
  id               String        @id @default(uuid())
  adjustmentNumber String        @unique
  productId        String
  locationId       String
  recordedQuantity Float
  physicalCount    Float
  difference       Float
  reason           String?
  status           String        @default("Done")
  validatedAt      DateTime?     @default(now())
  createdByUserId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  batchId          String?
  ProductBatch     ProductBatch? @relation(fields: [batchId], references: [id])
  createdByUser    User?         @relation(fields: [createdByUserId], references: [id])
  location         Location      @relation(fields: [locationId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])
}

model StockLedgerEntry {
  id                String        @id @default(uuid())
  movementType      String
  referenceDocument String
  productId         String
  quantity          Float
  fromLocationId    String?
  toLocationId      String?
  notes             String?
  userId            String?
  createdAt         DateTime      @default(now())
  batchId           String?
  ProductBatch      ProductBatch? @relation(fields: [batchId], references: [id])
  fromLocation      Location?     @relation("LedgerFrom", fields: [fromLocationId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])
  toLocation        Location?     @relation("LedgerTo", fields: [toLocationId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
}

model InventoryAnomaly {
  id                String    @id
  type              String
  severity          String
  description       String
  productId         String?
  locationId        String?
  referenceDocument String?
  status            String    @default("OPEN")
  resolvedByUserId  String?
  resolutionNotes   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Location          Location? @relation(fields: [locationId], references: [id])
  Product           Product?  @relation(fields: [productId], references: [id])
  User              User?     @relation(fields: [resolvedByUserId], references: [id])
}

model ProductBatch {
  id                  String                @id
  productId           String
  batchNumber         String
  expiryDate          DateTime?
  createdAt           DateTime              @default(now())
  DeliveryItem        DeliveryItem[]
  InventoryAdjustment InventoryAdjustment[]
  InventoryBalance    InventoryBalance[]
  Product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  ReceiptItem         ReceiptItem[]
  StockLedgerEntry    StockLedgerEntry[]
  TransferItem        TransferItem[]

  @@unique([productId, batchNumber])
}

model SimulationScenario {
  id              String   @id @default(uuid())
  name            String
  description     String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdByUser User?             @relation(fields: [createdByUserId], references: [id])
  events        SimulationEvent[]
}

model SimulationEvent {
  id                    String   @id @default(uuid())
  scenarioId            String
  eventType             String // RECEIPT, DELIVERY, TRANSFER
  productId             String
  expectedDate          DateTime
  quantity              Float
  sourceLocationId      String?
  destinationLocationId String?

  scenario            SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  sourceLocation      Location?          @relation("SimSource", fields: [sourceLocationId], references: [id])
  destinationLocation Location?          @relation("SimDest", fields: [destinationLocationId], references: [id])
}
